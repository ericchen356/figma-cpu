{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@figma/plugin-typings", "node"]
  },
  "include": ["src", "ui", "test", "types.d.ts"]
}
