{
  "maxTStates": 18,
  "signals": [
    { "name": "PC_OUT", "drives": "addr", "desc": "PC → address bus" },
    { "name": "HL_OUT", "drives": "addr", "desc": "H:L → address bus" },
    { "name": "W_OUT", "drives": "addr", "desc": "W latch → address bus" },
    { "name": "SP_OUT", "drives": "addr", "desc": "SP → address bus" },
    { "name": "MAR_LOAD", "desc": "MAR ← address bus" },
    { "name": "MEM_READ", "desc": "MDR ← mem[MAR]" },
    { "name": "MEM_WRITE", "desc": "mem[MAR] ← MDR" },
    { "name": "MDR_LOAD", "desc": "MDR ← data bus" },
    { "name": "MDR_OUT", "drives": "data", "desc": "MDR → data bus" },
    { "name": "REG_OUT", "drives": "data", "desc": "register → data bus" },
    { "name": "T_OUT", "drives": "data", "desc": "T latch → data bus" },
    { "name": "Y_OUT", "drives": "data", "desc": "Y latch (ALU result) → data bus" },
    { "name": "PCH_OUT", "drives": "data", "desc": "PC high byte → data bus" },
    { "name": "PCL_OUT", "drives": "data", "desc": "PC low byte → data bus" },
    { "name": "IR_LOAD", "desc": "IR ← data bus" },
    { "name": "OPR_LOAD", "desc": "OPR (register byte) ← data bus" },
    { "name": "T_LOAD", "desc": "T latch ← data bus" },
    { "name": "W_LO_LOAD", "desc": "W low byte ← data bus" },
    { "name": "W_HI_LOAD", "desc": "W high byte ← data bus" },
    { "name": "A_LOAD", "desc": "A latch (ALU input 1) ← data bus" },
    { "name": "REG_LOAD", "desc": "register ← data bus" },
    { "name": "PC_LOAD", "desc": "PC ← address bus" },
    { "name": "PCH_LOAD", "desc": "PC high byte ← data bus" },
    { "name": "PCL_LOAD", "desc": "PC low byte ← data bus" },
    { "name": "HL_LOAD", "desc": "H:L ← address bus" },
    { "name": "ALU_OP", "desc": "ALU computes A latch ⊕ data bus" },
    { "name": "Y_LOAD", "desc": "Y latch ← ALU result" },
    { "name": "FLAGS_LOAD", "desc": "Z C N ← ALU flags" },
    { "name": "PC_INC", "desc": "PC ← PC + 1" },
    { "name": "SP_INC", "desc": "SP ← SP + 1" },
    { "name": "SP_DEC", "desc": "SP ← SP − 1" },
    { "name": "HL_INC", "desc": "H:L ← H:L + 1" },
    { "name": "T_RESET", "desc": "end of instruction, T-state counter → T0" },
    { "name": "HALT", "desc": "stop the clock" }
  ]
}
