{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["es2020", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@figma/plugin-typings", "node"]
  },
  "include": ["src", "test", "spike/src"]
}
