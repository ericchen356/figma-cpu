{
  "name": "figmacpu-silicon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gate-level CPU drawn in Figma and executed by Figma's prototype engine",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "cpu": "node cli/run.mjs",
    "test": "vitest run",
    "audit": "node tools/audit-file.mjs",
    "connector:chunks": "esbuild tools/connector/chunks.ts --bundle --platform=node --format=esm --loader:.asm=text --outfile=tools/connector/out/chunks.mjs --log-level=warning && node tools/connector/out/chunks.mjs"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.142.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
